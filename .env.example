# ============================================
# VARIÁVEIS DE AMBIENTE - TEMPLATE
# ============================================
# Este é um arquivo de EXEMPLO
# Copie para .env e preencha com valores reais
# NUNCA commite o arquivo .env real!
# ============================================

# ============================================
# 🌐 CONFIGURAÇÕES DA API
# ============================================

# URL base da API (backend)
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Chave da API (se necessário)
# VITE_API_KEY=sua_chave_api_aqui


# ============================================
# 🔐 AUTENTICAÇÃO
# ============================================

# JWT Secret (backend)
# JWT_SECRET=seu_secret_jwt_super_seguro_aqui_min_32_chars

# Tempo de expiração do token (em segundos)
# JWT_EXPIRES_IN=86400


# ============================================
# 💾 BANCO DE DADOS
# ============================================

# PostgreSQL / MySQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/agenda_jhoninha
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=agenda_jhoninha
# DATABASE_USER=seu_usuario
# DATABASE_PASSWORD=sua_senha_segura


# ============================================
# 📧 EMAIL / NOTIFICAÇÕES
# ============================================

# SMTP (para envio de emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_app
# EMAIL_FROM=noreply@agendajhoninha.com.br


# ============================================
# 💬 WHATSAPP API
# ============================================

# WhatsApp Business API
# WHATSAPP_API_URL=https://api.whatsapp.com/v1
# WHATSAPP_TOKEN=seu_token_whatsapp
# WHATSAPP_PHONE_ID=seu_phone_id
# WHATSAPP_BUSINESS_ACCOUNT_ID=seu_account_id


# ============================================
# 📱 NOTIFICAÇÕES PUSH
# ============================================

# Firebase Cloud Messaging (FCM)
# FIREBASE_API_KEY=sua_firebase_api_key
# FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
# FIREBASE_PROJECT_ID=seu-projeto-id
# FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
# FIREBASE_APP_ID=seu_app_id
# FIREBASE_VAPID_KEY=sua_vapid_key


# ============================================
# 📊 ANALYTICS E MONITORING
# ============================================

# Google Analytics
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry (Error Tracking)
# SENTRY_DSN=https://seu_dsn@sentry.io/projeto_id
# SENTRY_AUTH_TOKEN=seu_token


# ============================================
# ☁️ CLOUD STORAGE
# ============================================

# AWS S3 (para upload de imagens)
# AWS_ACCESS_KEY_ID=sua_access_key
# AWS_SECRET_ACCESS_KEY=sua_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=agenda-jhoninha-images

# Cloudinary (alternativa para imagens)
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=seu_api_secret


# ============================================
# 💳 PAGAMENTOS
# ============================================

# Stripe
# STRIPE_PUBLIC_KEY=pk_test_sua_chave_publica
# STRIPE_SECRET_KEY=sk_test_sua_chave_secreta
# STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret

# Mercado Pago
# MERCADO_PAGO_PUBLIC_KEY=APP_USR_sua_public_key
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR_seu_access_token


# ============================================
# 🗺️ MAPAS E LOCALIZAÇÃO
# ============================================

# Google Maps API
# VITE_GOOGLE_MAPS_API_KEY=sua_google_maps_key


# ============================================
# 🔧 DESENVOLVIMENTO
# ============================================

# Ambiente
NODE_ENV=development

# Porta do servidor (se aplicável)
# PORT=3000

# Debug mode
# DEBUG=true

# Log level
# LOG_LEVEL=debug


# ============================================
# 🚀 PRODUÇÃO
# ============================================

# URL do site em produção
# VITE_APP_URL=https://agendajhoninha.com.br

# Domínio permitido (CORS)
# ALLOWED_ORIGINS=https://agendajhoninha.com.br,https://admin.agendajhoninha.com.br


# ============================================
# 📝 NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA commite valores reais neste arquivo
# 2. Mantenha o .env.example atualizado
# 3. Use senhas fortes e únicas
# 4. Gere tokens seguros (min 32 caracteres)
# 5. Revogue credenciais antigas regularmente
# 6. Use variáveis diferentes para dev/prod
#
# Para gerar senhas seguras use:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ============================================
