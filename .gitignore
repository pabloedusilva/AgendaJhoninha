# ============================================
# Agenda Jhoninha - .gitignore
# ============================================

# Environment variables and sensitive configuration
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# Local configuration files
config.local.js
config.local.ts
secrets.json
credentials.json

# Certificates and keys
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Sensitive logs
auth.log
debug.log

# ============================================
# Dependencies
# ============================================

# Node modules
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# PNPM
.pnpm-debug.log

# ============================================
# Build outputs
# ============================================

# Distribution directories
dist/
dist-ssr/
build/
out/
.output/
.next/

# Build artifacts
**/dist/
**/build/
*.local

# ============================================
# IDE and editors
# ============================================

# Visual Studio Code
.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
atlassian-ide-plugin.xml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/

# ============================================
# Operating systems
# ============================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Testing and coverage
# ============================================

# Coverage reports
coverage/
*.lcov
.nyc_output/
lib-cov/
.coverage
*.cover
.hypothesis/
.pytest_cache/
htmlcov/

# Test results
test-results/
playwright-report/
playwright/.cache/
.cache/

# ============================================
# Logs and temporary files
# ============================================

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Process files
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================
# Cache files
# ============================================

# Vite cache
.vite/
vite.config.*.timestamp-*

# TypeScript cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Build tool caches
.turbo/
.parcel-cache/
.next/
.nuxt/

# Linter caches
.eslintcache
.stylelintcache

# ============================================
# PWA and Service Workers
# ============================================

# Generated service worker files
workbox-*.js
sw.js.map
service-worker.js.map

# Note: sw.js and manifest.json are tracked as they are part of the source code

# ============================================
# Mobile development
# ============================================

# Capacitor
.capacitor/
android/
ios/
*.keystore

# ============================================
# Cloud and deployment
# ============================================

# Storybook
storybook-static/
.storybook/

# Sentry
.sentryclirc

# Vercel
.vercel/

# Netlify
.netlify/

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Serverless
.serverless/

# Other
.fusebox/
.dynamodb/
.tern-port
.vscode-test

# ============================================
# Miscellaneous
# ============================================

# Git merge artifacts
*.orig
*.rej

# Subversion
.svn

# Temporary documentation
*-temp.md
*-draft.md
.notes/

# Backup files
*.backup
*.bak
*.old

# ============================================
# Project specific
# ============================================

# Frontend build outputs
/frontend/app/dist/
/frontend/admin/dashboard/dist/

# Exclude templates but keep example files
*.example
*.template
!.env.example
!config.example.js

# Important: Public assets ARE tracked
# The following directories should be committed:
# - /frontend/app/public/
# - /frontend/admin/dashboard/public/
# - All images, icons, and favicons in public folders
